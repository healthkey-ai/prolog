# Copy to .env for docker compose. Never commit .env.
SECRET_KEY=change-me
ALLOWED_HOSTS=survey.example.org
CORS_ALLOWED_ORIGINS=https://survey.example.org
PROLOG_PUBLIC_URL=https://survey.example.org
# Directory containing surveys/ and themes/ subdirectories to mount (customer content)
PROLOG_DATA_DIR=./examples/deploy
# Optional: comma-separated customer-specific terms for the neutrality guard
# NEUTRALITY_DENYLIST=
