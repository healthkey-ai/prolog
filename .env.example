# Copy to .env for docker compose. Never commit .env.
# Required: a long random value, e.g. `python -c 'import secrets; print(secrets.token_urlsafe(50))'`.
# The app container refuses to start while it is unset or a placeholder.
SECRET_KEY=
# Required: the database password (compose refuses to start without one).
POSTGRES_PASSWORD=
ALLOWED_HOSTS=survey.example.org
CORS_ALLOWED_ORIGINS=https://survey.example.org
# Public origin of the runner; invitation emails link here (never sent while it
# points at localhost outside DEBUG).
PROLOG_PUBLIC_URL=https://survey.example.org
# Reverse proxies in front of the app (TLS termination). 1 trusts the proxy's
# X-Forwarded-For / X-Forwarded-Proto; leave 0 when the app is exposed directly.
PROLOG_NUM_PROXIES=1
# HTTP -> HTTPS redirect (on by default). Set false only to try the image over
# plain HTTP on localhost; the proxy usually redirects anyway.
# SECURE_SSL_REDIRECT=true
# IANA zone for calendar dates: effective windows, repeat due dates, captured_on.
# TIME_ZONE=UTC
# Directory containing surveys/ and themes/ subdirectories to mount (customer content)
PROLOG_DATA_DIR=./examples/deploy
# Optional: comma-separated customer-specific terms for the neutrality guard
# NEUTRALITY_DENYLIST=
# Throttle counters live in the Django cache (per worker process by default,
# so each rate is effectively multiplied by WEB_CONCURRENCY). For exact limits
# point these at a cache shared by all workers; see docs/deployment.md.
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://cache:6379/1
# Rates per hashed client address; raise CREATE/CAPTURE behind shared NAT.
# PROLOG_THROTTLE_CREATE=30/hour
# PROLOG_THROTTLE_CAPTURE=30/hour
# PROLOG_THROTTLE_WRITE=3000/hour
# Invitations (send_due_invitations): a real mail backend and the sender.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# PROLOG_EMAIL_FROM=surveys@example.org
# Retention of in-progress responses in days (at least 1).
# PROLOG_ABANDONED_RESPONSE_DAYS=90
# Largest request body the runner API accepts, in bytes (answers and emails
# are small; definitions are never uploaded).
# DATA_UPLOAD_MAX_MEMORY_SIZE=262144
# Runner build-time variable (npm run build): per-request deadline in ms.
# VITE_API_TIMEOUT_MS=20000
# Bare-host installs only: directory of the built runner (the image bakes it in).
# PROLOG_RUNNER_DIST=/opt/prolog/frontend/dist
